# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventsphere
JWT_SECRET=<long-random-string>
PORT=5000
NODE_ENV=development
# Password for all demo accounts made by `npm run seed` (min 8 chars)
SEED_PASSWORD=<demo-password>
# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173,https://<your-frontend>.vercel.app
